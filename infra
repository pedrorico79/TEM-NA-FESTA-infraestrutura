#!/usr/bin/env bash
# infra: comando principal do Tem Na Festa (08, seção 5).
# Roda em bash; no Windows, dentro do WSL 2 com Ubuntu (08, seção 5.1).
# Nesta versão (etapa E0 de 09) só existem `--help` e `doctor`; os demais
# comandos chegam nas etapas indicadas em `infra --help`.
set -euo pipefail

INFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=scripts/lib/common.sh
source "$INFRA_ROOT/scripts/lib/common.sh"

TF_MIN_VERSION="1.11.0"
LAB_REGIONS="us-east-1 us-west-2"
GUIDE="docs/primeiros-passos-windows.md"

usage() {
  cat <<'EOF'
Uso: infra <comando> [opções]

Comandos (a etapa de 09 em que cada um chega está entre parênteses):
  doctor                       confere ferramentas, credenciais, região e o ambiente WSL (E0; aviso de sobras na E2)
  session [minutos]            tempo restante da sessão do laboratório (E2)
  bootstrap                    cria ou adota os buckets de state e bronze e aplica a configuração (E2)
  init-secrets                 cria o secrets.env, só com a mensageria ligada (E8)
  plan <env>                   mostra o plano do Terraform, sem criar nada (E3)
  up <env> [--snapshot <id>]   cria ou atualiza o ambiente (E3)
  status <env>                 situação dos nós, stacks, versões e ALB (E4a)
  access <env> [--ip <ip>]     chave SSH e IP autorizado no bastion (E4a)
  ssh <env> [nó]               SSH pelo bastion até o nó (E4a)
  snapshot <env>               snapshot manual do banco (E4b)
  snapshots <env>              lista os snapshots do ambiente (E4b)
  down <env>                   destrói o ambiente, com snapshot final do banco (E3)
  analytics <plan|up>          camada persistente de dados: Lambda da EBD, Glue e Athena (E10)
  dataset run <alvo>           roda uma coleta agora: pof-trends, dev ou prod (E10)
  dataset upload <alvo> <pasta>  plano B: envia ao bronze a coleta feita localmente (E10)

Ambientes: dev, prod. Ajuda de um comando: infra <comando> --help
Referência: specs/08-estrutura-do-repositorio.md, seção 5.
EOF
}

usage_doctor() {
  cat <<'EOF'
Uso: infra doctor

Confere, sem alterar nada:
  - o ambiente: WSL e repositório fora de /mnt/c (08, seção 5.1);
  - as ferramentas: Terraform 1.11 ou superior, AWS CLI v2, jq e curl, e as
    de desenvolvimento (make, shellcheck, tflint, bats, yamllint);
  - as credenciais do laboratório (aws sts get-caller-identity) e a região.
Para cada item que faltar, diz o que fazer.
Saída: 0 tudo certo; 2 há pendências.
EOF
}

# --- doctor -----------------------------------------------------------------

problems=0
problem() { problems=$((problems + 1)); say_miss "$*"; }

check_environment() {
  if is_wsl; then
    say_ok "rodando no WSL"
  else
    say_info "fora do WSL (Linux ou macOS nativos também funcionam)"
  fi
  if is_windows_mount "$INFRA_ROOT"; then
    problem "o repositório está em $INFRA_ROOT, no disco do Windows (/mnt/...). Clone-o dentro do sistema de arquivos do WSL, por exemplo em ~/projetos (passo 3 de $GUIDE). Em /mnt/c as permissões 600 da chave SSH e do secrets.env não funcionam."
  else
    say_ok "repositório no sistema de arquivos do Linux ($INFRA_ROOT)"
  fi
}

check_terraform() {
  if ! command -v terraform >/dev/null 2>&1; then
    problem "terraform: não encontrado. Instale o Terraform $TF_MIN_VERSION ou superior (passo 2.2 de $GUIDE)."
    return
  fi
  local v
  v="$(terraform version 2>/dev/null | head -n 1 | sed -n 's/^Terraform v\([0-9][0-9.]*\).*/\1/p')"
  if [[ -z "$v" ]]; then
    problem "terraform: não foi possível ler a versão. Reinstale pelo passo 2.2 de $GUIDE."
  elif ! version_ge "$v" "$TF_MIN_VERSION" || version_ge "$v" "2.0.0"; then
    problem "terraform $v: é preciso a versão $TF_MIN_VERSION ou superior, abaixo da 2.0 (08, seção 4.1). Atualize pelo passo 2.2 de $GUIDE."
  else
    say_ok "terraform $v"
  fi
}

check_aws_cli() {
  if ! command -v aws >/dev/null 2>&1; then
    problem "aws: não encontrado. Instale o AWS CLI v2 (passo 2.3 de $GUIDE)."
    return 1
  fi
  local v
  v="$(aws --version 2>&1 | head -n 1 | sed -n 's/^aws-cli\/\([0-9][0-9.]*\).*/\1/p')"
  if [[ "${v%%.*}" != "2" ]]; then
    problem "aws ${v:-?}: é preciso o AWS CLI v2. Instale pelo passo 2.3 de $GUIDE."
    return 1
  fi
  say_ok "aws-cli $v"
}

check_simple_tool() {
  local tool="$1" hint="$2"
  if command -v "$tool" >/dev/null 2>&1; then
    say_ok "$tool"
  else
    problem "$tool: não encontrado. $hint"
  fi
}

check_dev_tool() {
  local tool="$1" hint="$2"
  if command -v "$tool" >/dev/null 2>&1; then
    say_ok "$tool"
  else
    say_warn "$tool: não encontrado; só é necessário para desenvolver (make check). $hint"
  fi
}

check_credentials() {
  local region
  region="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
  if [[ -z "$region" ]]; then
    region="$(aws configure get region 2>/dev/null || true)"
  fi
  if [[ -z "$region" ]]; then
    problem "região da AWS não configurada. Rode 'aws configure set region us-east-1' dentro do WSL (passo 4 de $GUIDE)."
  elif [[ " $LAB_REGIONS " != *" $region "* ]]; then
    problem "região $region: o laboratório só permite ${LAB_REGIONS// / ou } (03, T2). Rode 'aws configure set region us-east-1'."
  else
    say_ok "região $region"
  fi

  local out
  if out="$(timeout 30 aws sts get-caller-identity --query Account --output text 2>&1)"; then
    say_ok "credenciais do laboratório válidas (conta $out)"
  else
    problem "credenciais da AWS ausentes, inválidas ou vencidas. No Learner Lab, clique em Start Lab e em AWS Details, e cole o bloco [default] em ~/.aws/credentials dentro do WSL (passo 4 de $GUIDE). As credenciais configuradas no Windows não valem no WSL."
    return 1
  fi
}

# Sobras da infraestrutura antiga: só lista, nunca apaga (08, seção 5.2; G17).
check_leftovers() {
  local out
  if ! out="$(list_leftovers 2>&1)"; then
    say_warn "não foi possível procurar sobras na conta: ${out##*$'
'}"
    return 0
  fi
  if [[ -z "$out" ]]; then
    say_ok "nenhuma sobra da infraestrutura antiga (EC2, NAT, Elastic IP, load balancer, RDS) nesta região"
    return 0
  fi
  local kind id detail
  while read -r kind id detail; do
    say_warn "sobra provável: $kind $id ($detail)"
  done <<<"$out"
  say_warn "esses recursos não têm as etiquetas ManagedBy = terraform e Project = tem-na-festa. O infra não os apaga: remova-os à mão no console da AWS antes da E3, para não consumirem limites nem créditos (08, seção 5.2)."
}

# Buckets de artefatos de ambientes que não estão no ar: sobram quando alguém
# roda terraform destroy direto, sem o infra down (08, H23). Só avisa.
check_artifacts_leftovers() {
  local name env running
  while read -r name; do
    [[ "$name" =~ ^tnf-(dev|prod)-artifacts- ]] || continue
    env="${BASH_REMATCH[1]}"
    running="$(aws ec2 describe-instances \
      --filters "Name=tag:Project,Values=tem-na-festa" "Name=tag:Env,Values=$env" \
      "Name=instance-state-name,Values=pending,running,stopping,stopped" \
      --query 'length(Reservations[].Instances[])' --output text 2>/dev/null || echo 0)"
    if [[ "$running" == 0 ]]; then
      say_warn "sobra provável: bucket de artefatos $name, de um ambiente $env que não está no ar (por exemplo, depois de um terraform destroy sem o infra down). Ele guarda os tokens do Swarm: apague-o com 'aws s3 rb s3://$name --force'."
    fi
  done < <(aws s3api list-buckets --query 'Buckets[].Name' --output text 2>/dev/null | tr '\t' '\n')
}

cmd_doctor() {
  case "${1:-}" in
    -h | --help) usage_doctor; return 0 ;;
    "") ;;
    *) die "$EXIT_PRECONDITION" "opção desconhecida para doctor: $1 (use 'infra doctor --help')" ;;
  esac

  echo "== ambiente"
  check_environment
  echo "== ferramentas"
  check_terraform
  local aws_ok=0
  check_aws_cli && aws_ok=1
  check_simple_tool jq "Instale com 'sudo apt install -y jq'."
  check_simple_tool curl "Instale com 'sudo apt install -y curl'."
  check_dev_tool make "Instale com 'sudo apt install -y make'."
  check_dev_tool shellcheck "Instale com 'sudo apt install -y shellcheck'."
  check_dev_tool tflint "Instale pelo passo 2.4 de $GUIDE."
  check_dev_tool bats "Instale com 'sudo apt install -y bats'."
  check_dev_tool yamllint "Instale com 'sudo apt install -y yamllint'."
  echo "== credenciais e região"
  local creds_ok=0
  if [[ "$aws_ok" -eq 1 ]]; then
    check_credentials && creds_ok=1
  else
    problem "credenciais não conferidas: instale o AWS CLI v2 primeiro."
  fi
  echo "== sobras da infraestrutura antiga"
  if [[ "$creds_ok" -eq 1 ]] && command -v jq >/dev/null 2>&1; then
    check_leftovers
    check_artifacts_leftovers
  else
    say_info "procura de sobras pulada: precisa de credenciais válidas e do jq."
  fi

  echo
  if [[ "$problems" -eq 0 ]]; then
    echo "Tudo pronto."
    return "$EXIT_OK"
  fi
  echo "$problems pendência(s). Corrija os itens [falta] acima e rode 'infra doctor' de novo."
  return "$EXIT_PRECONDITION"
}

# --- session ---------------------------------------------------------------------

usage_session() {
  cat <<'EOF'
Uso: infra session [minutos]

A AWS não informa quando as credenciais do laboratório vencem (08, seção 5.3).
  infra session 90   registra que restam 90 minutos (leia o cronômetro do Learner Lab)
  infra session      mostra quanto resta: o valor informado ou uma estimativa
O registro fica em .infra/session.json, ligado a um resumo do token da sessão
(nunca ao token). Antes de up, down e bootstrap, com menos de 20 minutos, o
infra avisa e pede confirmação.
EOF
}

cmd_session() {
  case "${1:-}" in
    -h | --help) usage_session; return 0 ;;
  esac
  command -v aws >/dev/null 2>&1 || die "$EXIT_PRECONDITION" "aws não encontrado. Rode 'infra doctor'."
  command -v jq >/dev/null 2>&1 || die "$EXIT_PRECONDITION" "jq não encontrado. Rode 'infra doctor'."
  if [[ $# -gt 1 ]]; then
    die "$EXIT_PRECONDITION" "uso: infra session [minutos]"
  fi
  session_load
  if [[ -z "$SESSION_HASH" ]]; then
    say_info "as credenciais atuais não têm token de sessão (conta fora do laboratório): não há vencimento a acompanhar."
    return 0
  fi
  if [[ $# -eq 1 ]]; then
    if ! [[ "$1" =~ ^[0-9]+$ ]] || (($1 < 1 || $1 > SESSION_HOURS_MIN)); then
      die "$EXIT_PRECONDITION" "minutos inválidos: '$1'. Informe um número de 1 a $SESSION_HOURS_MIN, lido no cronômetro do Learner Lab."
    fi
    SESSION_REPORTED_MIN="$1"
    SESSION_REPORTED_AT="$(date +%s)"
    session_save
  fi
  local rem kind
  read -r rem kind < <(session_remaining)
  if [[ "$kind" == "informado" ]]; then
    echo "Restam cerca de $rem minuto(s) da sessão do laboratório (pelo valor informado)."
  else
    echo "Restam cerca de $rem minuto(s) da sessão do laboratório. É uma estimativa, contada desde a primeira vez que o infra viu estas credenciais; a sessão pode ter começado antes. Para o valor real: infra session <minutos>."
  fi
  if ((rem < SESSION_WARN_MIN)); then
    say_warn "menos de $SESSION_WARN_MIN minutos: renove a sessão no Learner Lab antes de up, down ou bootstrap."
  fi
}

# --- bootstrap -------------------------------------------------------------------

usage_bootstrap() {
  cat <<'EOF'
Uso: infra bootstrap

Cria, ou confirma que existem, o bucket do state e o bucket bronze, e aplica a
configuração deles (02, seção 2; 05, B3). Roda uma vez por conta e é seguro
repetir (G5).
  - Os buckets são criados com o AWS CLI, fora do Terraform (08, H20); o
    Terraform gerencia só versionamento, criptografia, bloqueio de acesso
    público e a política de só TLS.
  - Um bucket que já existe é adotado, sem tocar nos objetos; qualquer
    mudança num bucket existente é mostrada e só é aplicada com a sua
    confirmação (G16).
  - O state do bootstrap fica em bootstrap/terraform.tfstate, no bucket de state.
Saída: 0 concluído; 2 pré-condição não atendida ou cancelado.
EOF
}

BOOTSTRAP_DIR="$INFRA_ROOT/bootstrap"

tf_bootstrap() { terraform -chdir="$BOOTSTRAP_DIR" "$@"; }

# create_bucket <nome> <região>: cria o bucket com as etiquetas desta versão.
create_bucket() {
  local name="$1" region="$2"
  if [[ "$region" == us-east-1 ]]; then
    aws s3api create-bucket --bucket "$name" --region "$region" >/dev/null
  else
    aws s3api create-bucket --bucket "$name" --region "$region" \
      --create-bucket-configuration "LocationConstraint=$region" >/dev/null
  fi
  aws s3api put-bucket-tagging --bucket "$name" --region "$region" \
    --tagging 'TagSet=[{Key=Project,Value=tem-na-festa},{Key=Env,Value=shared},{Key=ManagedBy,Value=terraform}]'
  say_ok "bucket $name criado em $region."
}

cmd_bootstrap() {
  case "${1:-}" in
    -h | --help) usage_bootstrap; return 0 ;;
    "") ;;
    *) die "$EXIT_PRECONDITION" "opção desconhecida para bootstrap: $1 (use 'infra bootstrap --help')" ;;
  esac
  command -v terraform >/dev/null 2>&1 || die "$EXIT_PRECONDITION" "terraform não encontrado. Rode 'infra doctor'."

  # Credenciais, sessão, errored.tfstate e lock (08, seção 5.3).
  "$INFRA_ROOT/scripts/preflight.sh" bootstrap

  local tfvars="$BOOTSTRAP_DIR/terraform.tfvars"
  local account region bronze_region bronze state_bucket
  account="$(aws sts get-caller-identity --query Account --output text)"
  region="$(read_tfvar "$tfvars" region us-east-1)"
  bronze_region="$(read_tfvar "$tfvars" bronze_bucket_region us-east-1)"
  bronze="$(read_tfvar "$tfvars" bronze_bucket_name "bucket-bronze-$account-$bronze_region")"
  state_bucket="tnf-tfstate-$account-$region"

  local existed=0
  echo "== buckets"
  if aws s3api head-bucket --bucket "$state_bucket" >/dev/null 2>&1; then
    existed=1
    echo "state:  $state_bucket (já existe)"
  else
    create_bucket "$state_bucket" "$region"
  fi
  if aws s3api head-bucket --bucket "$bronze" >/dev/null 2>&1; then
    existed=1
    echo "bronze: $bronze (já existe; os objetos não são tocados)"
  else
    create_bucket "$bronze" "$bronze_region"
  fi

  echo "== terraform init"
  tf_bootstrap init -input=false -reconfigure \
    -backend-config="bucket=$state_bucket" -backend-config="region=$region" >/dev/null

  echo "== terraform plan"
  local plan_file="$INFRA_ROOT/.infra/bootstrap.tfplan" rc=0
  mkdir -p "$(dirname "$plan_file")"
  tf_bootstrap plan -input=false -detailed-exitcode -out="$plan_file" || rc=$?
  case "$rc" in
    0)
      rm -f "$plan_file"
      say_ok "a configuração dos buckets já está como o bootstrap define; nada a alterar."
      echo
      tf_bootstrap output
      ;;
    2)
      if [[ "$existed" -eq 1 ]]; then
        say_warn "o plano acima altera a configuração de bucket(s) que já existiam. Os objetos nunca são apagados nem alterados, mas confira em especial a política do bucket, que o Terraform substituiria (05, B3)."
        if ! confirm "Aplicar o plano?"; then
          rm -f "$plan_file"
          die "$EXIT_PRECONDITION" "nada foi aplicado. Ajuste o bootstrap/ se a diferença não for esperada e rode 'infra bootstrap' de novo."
        fi
      fi
      echo "== terraform apply"
      if ! tf_bootstrap apply -input=false "$plan_file"; then
        rm -f "$plan_file"
        die "$EXIT_UNEXPECTED" "o terraform apply do bootstrap falhou; veja a mensagem acima. Os buckets continuam existindo; corrija e rode 'infra bootstrap' de novo."
      fi
      rm -f "$plan_file"
      ;;
    *)
      rm -f "$plan_file"
      die "$EXIT_UNEXPECTED" "o terraform plan do bootstrap falhou; veja a mensagem acima."
      ;;
  esac

  say_ok "bootstrap concluído."
}

# --- plan, up e down -------------------------------------------------------------

usage_env_cmd() {
  cat <<USAGE
Uso: infra $1 <env> [--yes] [--ip <ip>]

  plan   mostra o plano do Terraform, sem criar nada
  up     cria ou atualiza o ambiente e espera ele ficar pronto
  down   destrói o ambiente e apaga o bucket de artefatos dele

Ambientes: dev ou prod. Antes de qualquer chamada ao Terraform, roda as
pré-checagens (credenciais, sessão, errored.tfstate, lock e, no up,
manager_count; 08, seções 5.3 e 5.4). up e down pedem para digitar o nome do
ambiente; --yes dispensa a pergunta só em dev (08, seção 5; G8).
Com admin_ssh_cidrs vazia no terraform.tfvars, plan e up detectam o seu IP
público (ou usam --ip) e autorizam só ele no bastion (08, seção 5.6).
Saída: 0 concluído; 1 erro do Terraform; 2 pré-condição não atendida ou
cancelado; 3 ambiente no ar, mas não pronto (04, seção 8).
USAGE
}

# confirm_env <op> <env> <yes>: pede o nome do ambiente digitado; --yes só vale em dev.
confirm_env() {
  local op="$1" env="$2" yes="$3" verb typed=""
  if [[ "$yes" -eq 1 && "$env" == dev ]]; then
    return 0
  fi
  if [[ "$yes" -eq 1 ]]; then
    say_warn "--yes não dispensa a confirmação em $env."
  fi
  verb="criar ou atualizar"
  [[ "$op" == down ]] && verb="DESTRUIR"
  printf 'Para %s o ambiente %s, digite o nome dele (%s); qualquer outra resposta cancela: ' "$verb" "$env" "$env" >&2
  read -r typed || true
  if [[ "$typed" != "$env" ]]; then
    die "$EXIT_PRECONDITION" "nada foi feito: a confirmação não confere."
  fi
}

# tf_env_init <env>: init da raiz do ambiente com o backend; define ACCOUNT, REGION e BUCKET.
tf_env_init() {
  local env="$1" state_region
  ACCOUNT="$(aws sts get-caller-identity --query Account --output text)"
  REGION="$(env_region "$env")"
  BUCKET="$(artifacts_bucket "$env" "$ACCOUNT" "$REGION")"
  state_region="$(read_tfvar "$INFRA_ROOT/bootstrap/terraform.tfvars" region us-east-1)"
  TF_DIR="$(env_tf_dir "$env")"
  TF_DATA_DIR="$(env_tf_data_dir "$env")"
  export TF_DATA_DIR
  terraform -chdir="$TF_DIR" init -input=false -reconfigure \
    -backend-config="bucket=tnf-tfstate-$ACCOUNT-$state_region" \
    -backend-config="region=$state_region" \
    -backend-config="key=$(env_state_key "$env")" >/dev/null
}

# ssh_cidr_args <env> <ip>: -var com o IP atual, se admin_ssh_cidrs estiver vazia.
ssh_cidr_args() {
  local env="$1" ip="$2" fixed current
  SSH_VAR=()
  fixed="$(sed -n -E 's/^[[:space:]]*admin_ssh_cidrs[[:space:]]*=[[:space:]]*\[(.*)\].*/\1/p' "$INFRA_ROOT/envs/$env/terraform.tfvars" | tr -d '" ')"
  if [[ -n "$fixed" ]]; then
    say_info "admin_ssh_cidrs está preenchida no terraform.tfvars: o infra não altera o IP autorizado (03, seção 3.6)."
    return 0
  fi
  if [[ -z "$ip" ]]; then
    ip="$(curl -fsS --max-time 10 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]')" || ip=""
  fi
  if ! [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || [[ "$ip" == 0.0.0.0 ]]; then
    die "$EXIT_PRECONDITION" "não foi possível detectar o seu IP público para autorizar o SSH no bastion. Informe-o com --ip <ip> (um único IPv4; 0.0.0.0/0 é proibido, T9)."
  fi
  current="$(terraform -chdir="$TF_DIR" output -json admin_ssh_cidrs 2>/dev/null | jq -r 'join(",")' 2>/dev/null || true)"
  if [[ -n "$current" && "$current" != "$ip/32" ]]; then
    say_warn "o IP autorizado no bastion mudará de $current para $ip/32."
  fi
  SSH_VAR=(-var="admin_ssh_cidrs=[\"$ip/32\"]")
}

# ensure_artifacts_bucket <env>: cria o bucket de artefatos com o AWS CLI (08, H23).
ensure_artifacts_bucket() {
  if aws s3api head-bucket --bucket "$BUCKET" >/dev/null 2>&1; then
    return 0
  fi
  if [[ "$REGION" == us-east-1 ]]; then
    aws s3api create-bucket --bucket "$BUCKET" --region "$REGION" >/dev/null
  else
    aws s3api create-bucket --bucket "$BUCKET" --region "$REGION" \
      --create-bucket-configuration "LocationConstraint=$REGION" >/dev/null
  fi
  aws s3api put-bucket-tagging --bucket "$BUCKET" --region "$REGION" \
    --tagging "TagSet=[{Key=Project,Value=tem-na-festa},{Key=Env,Value=$1},{Key=ManagedBy,Value=terraform}]"
  say_ok "bucket de artefatos $BUCKET criado."
}

cmd_env() {
  local op="$1"
  shift
  local env="" yes=0 ip="" snapshot=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help) usage_env_cmd "$op"; return 0 ;;
      --yes) yes=1; shift ;;
      --ip) ip="${2:-}"; shift 2 ;;
      --snapshot) snapshot="${2:-}"; shift 2 ;;
      -*) die "$EXIT_PRECONDITION" "opção desconhecida: $1 (use 'infra $op --help')" ;;
      *) env="$1"; shift ;;
    esac
  done
  command -v terraform >/dev/null 2>&1 || die "$EXIT_PRECONDITION" "terraform não encontrado. Rode 'infra doctor'."
  if [[ -n "$snapshot" && "$op" == down ]]; then
    die "$EXIT_PRECONDITION" "--snapshot só vale em infra up (e no plan, para conferir)."
  fi

  local pre_args=("$op" "$env")
  [[ "$yes" -eq 1 ]] && pre_args+=(--yes)
  "$INFRA_ROOT/scripts/preflight.sh" "${pre_args[@]}"

  if [[ "$op" != plan ]]; then
    confirm_env "$op" "$env" "$yes"
  fi

  load_manual_secrets "$env" "$op"

  # Pacote da Lambda de coleta do ambiente, na tag dataset_ref (10, seção 4).
  if [[ "$op" != down ]] && datasets_on "$env"; then
    local dataset_ref
    dataset_ref="$(read_tfvar "$INFRA_ROOT/envs/$env/terraform.tfvars" dataset_ref "")"
    if [[ -n "$dataset_ref" ]]; then
      echo "== pacote da Lambda de coleta ($dataset_ref)"
      "$INFRA_ROOT/scripts/build-dataset-lambda.sh" tendencias "$dataset_ref" \
        "$(read_tfvar "$INFRA_ROOT/envs/$env/terraform.tfvars" dataset_repo_url https://github.com/pedrorico79/TEM-NA-FESTA-dataset)"
    fi
  fi

  echo "== terraform init ($env)"
  tf_env_init "$env"
  local tf_args=(-input=false -var-file="$INFRA_ROOT/envs/$env/terraform.tfvars")

  # Snapshot do banco: só em ambiente novo (04, seção 3, passo 7; 05, B2).
  local snap_var=()
  if [[ "$op" != down ]]; then
    local chosen
    chosen="$("$INFRA_ROOT/scripts/snapshots.sh" choose "$env" "$snapshot")"
    if [[ -n "$chosen" ]]; then
      snap_var=(-var="db_snapshot_identifier=$chosen")
    fi
  fi

  case "$op" in
    plan)
      ssh_cidr_args "$env" "$ip"
      echo "== terraform plan ($env)"
      terraform -chdir="$TF_DIR" plan "${tf_args[@]}" "${SSH_VAR[@]}" "${snap_var[@]}" || die "$EXIT_UNEXPECTED" "o terraform plan falhou; veja a mensagem acima."
      ;;
    up)
      ssh_cidr_args "$env" "$ip"
      ensure_artifacts_bucket "$env"
      echo "== terraform apply ($env)"
      terraform -chdir="$TF_DIR" apply -auto-approve "${tf_args[@]}" "${SSH_VAR[@]}" "${snap_var[@]}" ||
        die "$EXIT_UNEXPECTED" "o terraform apply falhou; veja a mensagem acima. Corrija e rode 'infra up $env' de novo (é idempotente)."
      wait_env "$env"
      ;;
    down)
      echo "== terraform destroy ($env)"
      terraform -chdir="$TF_DIR" destroy -auto-approve "${tf_args[@]}" ||
        die "$EXIT_UNEXPECTED" "o terraform destroy falhou; veja a mensagem acima. Rode 'infra down $env' de novo (é idempotente)."
      if aws s3api head-bucket --bucket "$BUCKET" >/dev/null 2>&1; then
        aws s3 rb "s3://$BUCKET" --force --region "$REGION" >/dev/null
        say_ok "bucket de artefatos $BUCKET apagado (com join.json e status/)."
      fi
      # Poda: mantém os 3 finais e os 3 manuais mais recentes (05, B2).
      "$INFRA_ROOT/scripts/snapshots.sh" prune "$env"
      # O próximo ambiente reusa os mesmos IPs fixos com chaves de host novas.
      rm -f "$INFRA_ROOT/.infra/known_hosts_$env"
      say_ok "ambiente $env destruído; o snapshot final do banco ficou guardado."
      ;;
  esac
}

# wait_env <env>: espera os nós e a convergência (04, seção 8) e mostra o acesso.
wait_env() {
  local env="$1" nodes bastion_ip prefix bastion="-" alb
  nodes="$(terraform -chdir="$TF_DIR" output -json node_ips | jq -r 'keys | join(",")')"
  bastion_ip="$(terraform -chdir="$TF_DIR" output -raw bastion_public_ip 2>/dev/null || true)"
  prefix="$(terraform -chdir="$TF_DIR" output -raw name_prefix)"
  alb="$(terraform -chdir="$TF_DIR" output -raw alb_dns_name 2>/dev/null || true)"
  [[ "$alb" == null ]] && alb=""
  [[ -n "$bastion_ip" && "$bastion_ip" != null ]] && bastion="$prefix-bastion"
  echo "== acompanhando a subida (até 25 minutos)"
  "$INFRA_ROOT/scripts/wait-ready.sh" "$env" "$BUCKET" "$REGION" "$nodes" "$bastion"
  [[ -n "$alb" ]] && wait_alb "$env" "http://$alb/"
  echo
  [[ -n "$alb" ]] && echo "Sistema: http://$alb/"
  if [[ "$bastion" != "-" ]]; then
    echo "Bastion: $bastion_ip"
    echo "SSH:     infra ssh $env app-1   (ou infra ssh $env para o bastion)"
  fi
}

# wait_alb <env> <url>: com a convergência pronta, o ALB precisa devolver 200
# em / (04, seção 8). O target group leva alguns ciclos de verificação para
# marcar os nós web como saudáveis.
wait_alb() {
  local env="$1" url="$2" code="" deadline
  deadline=$(($(date +%s) + ${TNF_ALB_TIMEOUT:-300}))
  echo "== conferindo o ALB ($url)"
  while :; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$url" 2>/dev/null || true)"
    if [[ "$code" == 200 ]]; then
      say_ok "o ALB respondeu 200 em /."
      return 0
    fi
    if (($(date +%s) >= deadline)); then
      die "$EXIT_TIMEOUT" "a convergência ficou pronta, mas o ALB não respondeu 200 em / (última resposta: ${code:-nenhuma}). Confira os alvos do target group no console (nós web saudáveis na porta 80) e o frontend no líder: infra ssh $env app-1, depois docker service ps tnf-web_frontend."
    fi
    sleep "${TNF_WAIT_INTERVAL:-15}"
  done
}

