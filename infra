ANALYTICS_DIR="$INFRA_ROOT/analytics"
# Ordem de criação das visões: cada uma pode usar as anteriores.
ANALYTICS_VIEWS="vw_pof_trends_atual vw_pof_trends_sazonalidade vw_pof_trends_consumo_x_estabilidade vw_tendencias_produtos_atual"

usage_analytics() {
  cat <<'EOF'
Uso: infra analytics <plan|up>

Camada persistente de dados analíticos (10, DA5): a Lambda semanal da base da
EBD, o catálogo do Glue, o workgroup do Athena e o bucket de resultados.
  plan   empacota a Lambda e mostra o plano, sem criar nada
  up     empacota, cria o bucket de resultados se faltar, aplica e cria as
         visões de analytics/views/ no Athena
Fica no ar com ou sem ambiente; o infra down não a toca.
EOF
}

# analytics_context: conta, região, bronze, bucket de resultados e tag.
analytics_context() {
  ACCOUNT="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)" ||
    die "$EXIT_PRECONDITION" "credenciais da AWS ausentes, inválidas ou vencidas. Atualize-as no WSL e rode de novo."
  A_REGION="$(read_tfvar "$ANALYTICS_DIR/terraform.tfvars" region us-east-1)"
  A_RESULTS="tnf-athena-$ACCOUNT-$A_REGION"
  A_BRONZE="bucket-bronze-$ACCOUNT-$(read_tfvar "$INFRA_ROOT/bootstrap/terraform.tfvars" bronze_bucket_region us-east-1)"
  A_REF="$(read_tfvar "$ANALYTICS_DIR/terraform.tfvars" dataset_ref "")"
}

# athena_ddl <arquivo.sql>: executa um comando no workgroup tnf e espera.
athena_ddl() {
  local id state reason
  id="$(aws athena start-query-execution --region "$A_REGION" --work-group tnf \
    --query-execution-context Database=tnf_bronze --query-string "file://$1" \
    --query QueryExecutionId --output text)"
  for _ in $(seq 1 60); do
    state="$(aws athena get-query-execution --region "$A_REGION" --query-execution-id "$id" \
      --query QueryExecution.Status.State --output text)"
    case "$state" in
      SUCCEEDED) return 0 ;;
      FAILED | CANCELLED)
        reason="$(aws athena get-query-execution --region "$A_REGION" --query-execution-id "$id" \
          --query QueryExecution.Status.StateChangeReason --output text)"
        die "$EXIT_UNEXPECTED" "a visão $(basename "$1" .sql) falhou no Athena: $reason"
        ;;
    esac
    sleep "${TNF_ATHENA_POLL:-2}"
  done
  die "$EXIT_TIMEOUT" "a visão $(basename "$1" .sql) não terminou em 2 minutos no Athena."
}

cmd_analytics() {
  local op="${1:-}"
  case "$op" in
    -h | --help | "") usage_analytics; return 0 ;;
    plan | up) ;;
    *) die "$EXIT_PRECONDITION" "use 'infra analytics plan' ou 'infra analytics up'." ;;
  esac
  command -v terraform >/dev/null 2>&1 || die "$EXIT_PRECONDITION" "terraform não encontrado. Rode 'infra doctor'."
  analytics_context
  [[ -n "$A_REF" ]] || die "$EXIT_PRECONDITION" "preencha dataset_ref em analytics/terraform.tfvars com uma tag do repositório TEM-NA-FESTA-dataset (10, seção 7)."

  echo "== pacote da Lambda da base da EBD ($A_REF)"
  local zip
  zip="$("$INFRA_ROOT/scripts/build-dataset-lambda.sh" pof-trends "$A_REF" \
    "$(read_tfvar "$ANALYTICS_DIR/terraform.tfvars" dataset_repo_url https://github.com/pedrorico79/TEM-NA-FESTA-dataset)")"

  if [[ "$op" == up ]] && ! aws s3api head-bucket --bucket "$A_RESULTS" >/dev/null 2>&1; then
    if [[ "$A_REGION" == us-east-1 ]]; then
      aws s3api create-bucket --bucket "$A_RESULTS" --region "$A_REGION" >/dev/null
    else
      aws s3api create-bucket --bucket "$A_RESULTS" --region "$A_REGION" \
        --create-bucket-configuration "LocationConstraint=$A_REGION" >/dev/null
    fi
    say_ok "bucket de resultados do Athena $A_RESULTS criado."
  fi

  local state_region
  state_region="$(read_tfvar "$INFRA_ROOT/bootstrap/terraform.tfvars" region us-east-1)"
  TF_DATA_DIR="$INFRA_ROOT/.infra/tfdata/analytics"
  export TF_DATA_DIR
  echo "== terraform init (analytics)"
  terraform -chdir="$ANALYTICS_DIR" init -input=false -reconfigure \
    -backend-config="bucket=tnf-tfstate-$ACCOUNT-$state_region" \
    -backend-config="region=$state_region" >/dev/null
  local tf_args=(-input=false -var-file="$ANALYTICS_DIR/terraform.tfvars" -var="lambda_zip_path=$zip")
  if [[ "$op" == plan ]]; then
    echo "== terraform plan (analytics)"
    terraform -chdir="$ANALYTICS_DIR" plan "${tf_args[@]}" || die "$EXIT_UNEXPECTED" "o terraform plan falhou; veja a mensagem acima."
    return 0
  fi
  echo "== terraform apply (analytics)"
  terraform -chdir="$ANALYTICS_DIR" apply -auto-approve "${tf_args[@]}" ||
    die "$EXIT_UNEXPECTED" "o terraform apply falhou; veja a mensagem acima. Corrija e rode 'infra analytics up' de novo (é idempotente)."
  echo "== visões no Athena"
  local view
  for view in $ANALYTICS_VIEWS; do
    athena_ddl "$ANALYTICS_DIR/views/$view.sql"
    say_ok "visão $view"
  done
  say_ok "camada analytics pronta: workgroup tnf, banco tnf_bronze, Lambda tnf-coleta-pof-trends."
}

usage_dataset() {
  cat <<'EOF'
Uso: infra dataset run <pof-trends|dev|prod> [--prazo <segundos>]
     infra dataset upload <pof-trends|dev|prod> <pasta arquivos-gerados>

  run      roda a coleta agora e mostra o resumo: pof-trends é a base da EBD
           (camada analytics); dev ou prod, os produtos do sistema do ambiente.
           --prazo encurta o prazo da Lambda, para testar a interrupção (D8).
  upload   plano B (10, DA2): envia ao bronze a coleta feita na sua máquina
           pelo script do dataset (pasta arquivos-gerados), no mesmo layout.
Saída: 0 coleta gravada; 3 coleta interrompida (veja as rejeições).
EOF
}

# dataset_target <pof-trends|env>: função, região e base do bronze.
dataset_target() {
  analytics_context
  case "$1" in
    pof-trends) D_FUNCTION=tnf-coleta-pof-trends D_REGION="$A_REGION" D_BASE=pof_trends D_FILTER="*" ;;
    dev | prod) D_FUNCTION="tnf-$1-tendencias" D_REGION="$(env_region "$1")" D_BASE=tendencias_produtos D_FILTER="*env=$1/*" ;;
    *) die "$EXIT_PRECONDITION" "informe pof-trends, dev ou prod (10, seção 4)." ;;
  esac
}

cmd_dataset() {
  local action="${1:-}" target="${2:-}"
  case "$action" in
    -h | --help | "") usage_dataset; return 0 ;;
    run | upload) ;;
    *) die "$EXIT_PRECONDITION" "use 'infra dataset run' ou 'infra dataset upload' (veja --help)." ;;
  esac
  shift 2 || true
  dataset_target "$target"

  if [[ "$action" == upload ]]; then
    local pasta="${1:-}"
    [[ -d "$pasta/datasets/$D_BASE" ]] ||
      die "$EXIT_PRECONDITION" "não encontrei $pasta/datasets/$D_BASE. Informe a pasta arquivos-gerados do repositório do dataset, depois de rodar o script (com TNF_ENV=$target na base dos produtos)."
    aws s3 cp --recursive --only-show-errors --region "$D_REGION" \
      --exclude "*" --include "$D_FILTER" --exclude "*.tmp" \
      "$pasta/datasets/$D_BASE/" "s3://$A_BRONZE/datasets/$D_BASE/"
    say_ok "coleta enviada a s3://$A_BRONZE/datasets/$D_BASE/; ela aparece nas consultas do Athena sem crawler."
    return 0
  fi

  local payload='{}' out
  if [[ "${1:-}" == --prazo ]]; then
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "$EXIT_PRECONDITION" "--prazo precisa de um número de segundos."
    payload="{\"prazo_segundos\": $2}"
  fi
  out="$(mktemp)"
  echo "== coleta $D_FUNCTION (pode levar alguns minutos)"
  aws lambda invoke --function-name "$D_FUNCTION" --region "$D_REGION" \
    --cli-read-timeout 960 --cli-binary-format raw-in-base64-out \
    --payload "$payload" "$out" >/dev/null 2>"$out.err" ||
    die "$EXIT_PRECONDITION" "não foi possível invocar $D_FUNCTION: $(tail -n 1 "$out.err"). Ela existe? (infra analytics up, ou datasets_enabled = true e infra up $target)"
  jq -r '"  status:     \(.status)",
         "  data:       \(.data_coleta)",
         (if .status == "ok" then "  produtos:   \(.produtos)" else "  motivo:     \(.motivo)" end),
         "  rejeições:  \(.rejeicoes)",
         (.chaves[]? | "  gravado:    \(.)")' "$out" 2>/dev/null || cat "$out"
  if [[ "$(jq -r .status "$out" 2>/dev/null)" == ok ]]; then
    rm -f "$out" "$out.err"
    say_ok "coleta gravada."
    return 0
  fi
  rm -f "$out" "$out.err"
  die "$EXIT_TIMEOUT" "a coleta foi interrompida sem gravar nada; a anterior ficou intacta. Veja o motivo acima e o arquivo de rejeições."
}

not_yet() {
  die "$EXIT_PRECONDITION" "o comando '$1' ainda não está implementado; ele chega na etapa $2 do plano (specs/09-plano-de-implementacao.md)."
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    "" | -h | --help | help) usage ;;
    doctor) cmd_doctor "$@" ;;
    session) cmd_session "$@" ;;
    bootstrap) cmd_bootstrap "$@" ;;
    plan | up | down) cmd_env "$cmd" "$@" ;;
    status) cmd_status "$@" ;;
    access) cmd_access "$@" ;;
    ssh) cmd_ssh "$@" ;;
    snapshot) cmd_snapshot create "$@" ;;
    snapshots) cmd_snapshot list "$@" ;;
    init-secrets) cmd_init_secrets "$@" ;;
    analytics) cmd_analytics "$@" ;;
    dataset) cmd_dataset "$@" ;;
    *) die "$EXIT_PRECONDITION" "comando desconhecido: '$cmd'. Veja 'infra --help'." ;;
  esac
}

main "$@"
