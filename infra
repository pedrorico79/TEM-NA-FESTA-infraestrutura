cmd_status() {
  local env="${1:-}"
  case "$env" in
    -h | --help) echo "Uso: infra status <env>: situação dos nós e da convergência (04, seção 8)."; return 0 ;;
    dev | prod) ;;
    *) die "$EXIT_PRECONDITION" "informe o ambiente: dev ou prod (03, T1)." ;;
  esac
  local account region bucket stack_env nodes bastion="-" listing
  account="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)" ||
    die "$EXIT_PRECONDITION" "credenciais da AWS ausentes, inválidas ou vencidas."
  region="$(env_region "$env")"
  bucket="$(artifacts_bucket "$env" "$account" "$region")"
  if ! stack_env="$(aws s3 cp "s3://$bucket/stack.env" - --region "$region" 2>/dev/null)"; then
    say_info "o ambiente $env não está no ar (não há bucket de artefatos)."
    return "$EXIT_OK"
  fi
  nodes="$(sed -n 's/^EXPECTED_NODES=//p' <<<"$stack_env")"
  listing="$(aws s3 ls "s3://$bucket/status/nodes/" --region "$region" 2>/dev/null || true)"
  if grep -q -- '-bastion\.json$' <<<"$listing"; then
    bastion="$(awk '{print $4}' <<<"$listing" | grep -- '-bastion\.json$' | sed 's/\.json$//')"
  fi
  "$INFRA_ROOT/scripts/wait-ready.sh" "$env" "$bucket" "$region" "$nodes" "$bastion" --once
}

# cmd_snapshot <create|list> <env>: snapshot manual e listagem (05, B2; 08, seção 5.5).
cmd_snapshot() {
  local action="$1" env="${2:-}"
  case "$env" in
    -h | --help) "$INFRA_ROOT/scripts/snapshots.sh" --help; return 0 ;;
  esac
  if [[ "$action" == create ]]; then
    "$INFRA_ROOT/scripts/preflight.sh" plan "$env"
    tf_env_init "$env"
  else
    case "$env" in dev | prod) ;; *) die "$EXIT_PRECONDITION" "informe o ambiente: dev ou prod (03, T1)." ;; esac
  fi
  "$INFRA_ROOT/scripts/snapshots.sh" "$action" "$env"
}

cmd_access() {
  "$INFRA_ROOT/scripts/access.sh" "$@"
}

cmd_ssh() {
  local env="${1:-}" node="${2:-bastion}"
  case "$env" in
    -h | --help) echo "Uso: infra ssh <env> [nó]: SSH pelo bastion até o nó (app-1, web-1...; sem nó, o próprio bastion)."; return 0 ;;
  esac
  "$INFRA_ROOT/scripts/access.sh" "$env" --ssh
  TF_DIR="$(env_tf_dir "$env")"
  TF_DATA_DIR="$(env_tf_data_dir "$env")"
  export TF_DATA_DIR
  local key="$INFRA_ROOT/.keys/$env.pem" bastion_ip prefix target known="$INFRA_ROOT/.infra/known_hosts_$env"
  bastion_ip="$(terraform -chdir="$TF_DIR" output -raw bastion_public_ip)"
  prefix="$(terraform -chdir="$TF_DIR" output -raw name_prefix)"
  local opts=(-i "$key" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o "UserKnownHostsFile=$known")
  if [[ "$node" == bastion ]]; then
    exec ssh "${opts[@]}" "ubuntu@$bastion_ip"
  fi
  target="$(terraform -chdir="$TF_DIR" output -json node_ips | jq -r --arg h "$prefix-$node" '.[$h] // empty')"
  [[ -n "$target" ]] || die "$EXIT_PRECONDITION" "nó '$node' não existe no ambiente $env. Use, por exemplo, app-1 ou web-1."
  exec ssh "${opts[@]}" -o "ProxyCommand=ssh ${opts[*]} -W %h:%p ubuntu@$bastion_ip" "ubuntu@$target"
}

