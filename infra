# --- segredos manuais (05, A5) -------------------------------------------------------

SECRETS_FILE="$INFRA_ROOT/secrets.env"
# Grupos de segredos manuais: a variável do Terraform e as chaves do
# secrets.env. A mensageria (E8) usa o token da Whapi; a coleta dos produtos
# do sistema (E10) usa o login do usuário de coleta (10, seção 8).
MESSAGING_SECRET_KEYS="whapi_token"
DATASET_SECRET_KEYS="dataset_api_email dataset_api_password"

# messaging_on <env>: 0 quando o terraform.tfvars liga a mensageria
# (service_replicas.messaging > 0); só assim há segredo manual (03, seção 3.4).
messaging_on() {
  local n
  n="$(awk '/service_replicas/,/}/' "$INFRA_ROOT/envs/$1/terraform.tfvars" |
    sed -n -E 's/^[[:space:]]*messaging[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' | head -n 1)"
  ((${n:-0} > 0))
}

# datasets_on <env>: 0 quando o terraform.tfvars liga a coleta (datasets_enabled).
datasets_on() {
  [[ "$(read_tfvar "$INFRA_ROOT/envs/$1/terraform.tfvars" datasets_enabled false)" == true ]]
}

# secret_value <chave>: valor da chave no secrets.env (formato chave=valor).
secret_value() {
  sed -n "s/^$1=//p" "$SECRETS_FILE" 2>/dev/null | tail -n 1
}

# export_secret_group <variável> <op> <motivo> <chaves...>: entrega as chaves ao
# Terraform por TF_VAR_<variável>, nunca por linha de comando (05, A5). Falta
# de arquivo ou de chave aborta antes do plan ou do apply (Q8). No down, sem o
# arquivo, segue com marcadores: o destroy não usa os valores.
export_secret_group() {
  local var="$1" op="$2" motivo="$3" key value json='{}' missing=""
  shift 3
  if [[ ! -f "$SECRETS_FILE" && "$op" == down ]]; then
    for key in "$@"; do json="$(jq -c --arg k "$key" '.[$k] = "sem-secrets-env"' <<<"$json")"; done
    export "TF_VAR_$var=$json"
    return 0
  fi
  if [[ ! -f "$SECRETS_FILE" ]]; then
    die "$EXIT_PRECONDITION" "$motivo e não há secrets.env. Crie-o com 'infra init-secrets' (05, A5); nada foi aplicado."
  fi
  for key in "$@"; do
    value="$(secret_value "$key")"
    if [[ -z "$value" ]]; then
      missing="$missing $key"
      continue
    fi
    json="$(jq -c --arg k "$key" --arg v "$value" '.[$k] = $v' <<<"$json")"
  done
  if [[ -n "$missing" ]]; then
    die "$EXIT_PRECONDITION" "falta(m) no secrets.env:$missing. Rode 'infra init-secrets' para preencher; nada foi aplicado."
  fi
  export "TF_VAR_$var=$json"
}

# load_manual_secrets <env> <op>: os grupos ligados no terraform.tfvars do ambiente.
load_manual_secrets() {
  local env="$1" op="$2"
  if messaging_on "$env"; then
    # shellcheck disable=SC2086 # as chaves são palavras separadas de propósito
    export_secret_group messaging_secrets "$op" "a mensageria está ligada em envs/$env/terraform.tfvars" $MESSAGING_SECRET_KEYS
  fi
  if datasets_on "$env"; then
    # shellcheck disable=SC2086
    export_secret_group dataset_secrets "$op" "a coleta (datasets_enabled) está ligada em envs/$env/terraform.tfvars" $DATASET_SECRET_KEYS
  fi
}

usage_init_secrets() {
  cat <<'EOF'
Uso: infra init-secrets

Cria (ou refaz) o secrets.env na raiz do repositório, com permissão 600 e
fora do Git, perguntando cada segredo manual sem mostrar o que é digitado
(05, A5). Deixe em branco o que não usa:
  whapi_token            token da API da Whapi (mensageria ligada)
  dataset_api_email      email do usuário de coleta (datasets_enabled = true)
  dataset_api_password   senha do usuário de coleta (datasets_enabled = true)
EOF
}

cmd_init_secrets() {
  case "${1:-}" in -h | --help) usage_init_secrets; return 0 ;; esac
  local key value content=""
  if [[ -f "$SECRETS_FILE" ]] && ! confirm "Já existe um secrets.env. Substituir?"; then
    say_info "nada foi alterado."
    return 0
  fi
  for key in $MESSAGING_SECRET_KEYS $DATASET_SECRET_KEYS; do
    value=""
    read -r -s -p "$key (em branco se não usa): " value || true
    echo
    [[ -n "$value" ]] || continue
    if [[ "$value" =~ [[:space:]] ]]; then
      die "$EXIT_PRECONDITION" "$key não pode ter espaços; nada foi gravado."
    fi
    content+="$key=$value"$'\n'
  done
  if [[ -z "$content" ]]; then
    die "$EXIT_PRECONDITION" "nenhum segredo informado; nada foi gravado."
  fi
  (
    umask 077
    printf '%s' "$content" >"$SECRETS_FILE"
  )
  chmod 600 "$SECRETS_FILE"
  say_ok "secrets.env gravado com permissão 600 (fora do Git)."
}

