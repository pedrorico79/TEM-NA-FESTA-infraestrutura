# Finais de linha LF em todos os arquivos de texto (08, seção 5.1).
# Com CRLF os scripts quebram no WSL ("^M: command not found").
* text=auto eol=lf

*.sh     text eol=lf
*.bash   text eol=lf
*.bats   text eol=lf
infra    text eol=lf
Makefile text eol=lf
*.tf     text eol=lf
*.tfvars text eol=lf
*.hcl    text eol=lf
*.tftpl  text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.conf   text eol=lf
*.md     text eol=lf
*.env    text eol=lf
*.example text eol=lf
